{
  "name": "auth-frontend-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:turbo": "next dev -p 3001 --turbo",
    "build": "next build",
    "start": "next start -p 3001",
    "prod": "npm run build && npm run start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "clean": "powershell -ExecutionPolicy Bypass -File ./clean-build.ps1",
    "generate-key": "node generate-key.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.7.0",
    "@reduxjs/toolkit": "^2.9.0",
    "axios": "^1.7.2",
    "crypto-js": "^4.2.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-redux": "^9.2.0",
    "react-toastify": "^9.1.3",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
